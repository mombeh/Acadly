generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Sequence {
  SEQUENCE_1
  SEQUENCE_2
  SEQUENCE_3
}

model AcademicYear {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  classes Class[]
}

model Class {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  academicYearId String   @db.Uuid
  createdAt      DateTime @default(now())

  academicYear  AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  students      Student[]
  classSubjects ClassSubject[]

  @@unique([name, academicYearId])
}

model Student {
  id            String   @id @default(uuid()) @db.Uuid
  studentNumber String   @unique
  firstName     String
  lastName      String
  classId       String   @db.Uuid
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  class Class  @relation(fields: [classId], references: [id], onDelete: Restrict)
  marks Mark[]
}

model Subject {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  code      String   @unique
  createdAt DateTime @default(now())

  classSubjects ClassSubject[]
}

model ClassSubject {
  id          String  @id @default(uuid()) @db.Uuid
  classId     String  @db.Uuid
  subjectId   String  @db.Uuid
  coefficient Decimal @db.Decimal(5, 2)

  class   Class   @relation(fields: [classId], references: [id], onDelete: Restrict)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  marks   Mark[]

  @@unique([classId, subjectId])
}

model Mark {
  id             String   @id @default(uuid()) @db.Uuid
  studentId      String   @db.Uuid
  classSubjectId String   @db.Uuid
  sequence       Sequence
  score          Decimal  @db.Decimal(5, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  classSubject ClassSubject @relation(fields: [classSubjectId], references: [id], onDelete: Restrict)

  @@unique([studentId, classSubjectId, sequence])
}
